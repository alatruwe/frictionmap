<!-- Debug view for Phase 2C. Phase 4 replaces this with the real UI. -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>ai-friction-map — Debug Report</title>
  <style>
    body { font-family: -apple-system, system-ui, sans-serif; max-width: 1100px; margin: 2rem auto; padding: 0 1rem; color: #222; }
    h1 { font-weight: 500; margin-bottom: 0.25rem; }
    .stats { font-variant-numeric: tabular-nums; color: #555; margin: 0 0 0.5rem; }
    .meta { font-size: 0.85rem; color: #777; }
    details { margin-top: 1.5rem; }
    summary { cursor: pointer; font-weight: 500; }
    pre { background: #f6f6f6; border: 1px solid #ddd; padding: 1rem; border-radius: 4px; overflow-x: auto; font-size: 0.78rem; line-height: 1.4; max-height: 80vh; }
  </style>
</head>
<body>
  <h1>ai-friction-map — Debug Report</h1>
  <p class="stats" id="stats"></p>
  <p class="meta" id="meta"></p>
  <details open>
    <summary>Report JSON</summary>
    <pre id="json"></pre>
  </details>
  <script>
    const DATA = {{DATA}};
    const meta = DATA.meta || {};
    document.getElementById('stats').textContent =
      `${(meta.name || '?')} — ${(meta.session_count || 0).toLocaleString()} sessions, `
      + `${(meta.file_count || 0).toLocaleString()} files with friction signals, `
      + `${(meta.total_event_count || 0).toLocaleString()} events, `
      + `${(meta.thinking_block_count || 0).toLocaleString()} thinking blocks.`;
    document.getElementById('meta').textContent =
      `Schema ${meta.schema_version || '?'} · generated ${meta.generated_at || '?'}`;
    document.getElementById('json').textContent = JSON.stringify(DATA, null, 2);
  </script>
</body>
</html>
