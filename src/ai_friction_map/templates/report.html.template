<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>ai-friction-map report</title>
  <style>
    body { font-family: -apple-system, system-ui, sans-serif; max-width: 640px; margin: 4rem auto; padding: 0 1rem; color: #222; }
    h1 { font-weight: 500; }
    .count { font-variant-numeric: tabular-nums; }
  </style>
</head>
<body>
  <h1>ai-friction-map</h1>
  <p class="count"></p>
  <script>
    const DATA = {{DATA}};
    document.querySelector('.count').textContent =
      `${DATA.event_count.toLocaleString()} events across ${DATA.session_count.toLocaleString()} sessions.`;
  </script>
</body>
</html>
